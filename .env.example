APP_NAME="GlobalBusinessOne"
APP_ENV=local
APP_KEY=base64:GENERAR_CON_php_artisan_key:generate
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ─── LOGS ──────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── BASE DE DATOS (App Laravel) ───────────────────────────
# Usando PostgreSQL por defecto en Docker
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=globalbusinessone
DB_USERNAME=sail
DB_PASSWORD=CAMBIAR_PASSWORD

# ─── (OPCIONAL) Conexión directa SQL Server SAP ────────────
# Descomenta si tienes credenciales de SQL Server para borrado
# masivo ultrarrápido (elimina 12,000 registros en < 5 seg)
# SAP_SQLSRV_HOST=192.168.0.100
# SAP_SQLSRV_PORT=1433
# SAP_SQLSRV_DATABASE=SBO_MANGO_BAJITO_PRODUCTIVA
# SAP_SQLSRV_USERNAME=sa
# SAP_SQLSRV_PASSWORD=CAMBIAR_PASSWORD_SA
# DB_TRUST_SERVER_CERTIFICATE=true

# ─── SESIÓN ────────────────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ─── BROADCAST / FILESYSTEM ────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ─── COLAS (Queue) ─────────────────────────────────────────
# Usar Redis para que los jobs de limpieza masiva funcionen
QUEUE_CONNECTION=redis

# ─── CACHE ─────────────────────────────────────────────────
# Redis requerido para el tracking de progreso del cleanup
CACHE_STORE=redis

# ─── REDIS ─────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── MAIL ──────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="admin@globalbusinessone.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── SAP BUSINESS ONE SERVICE LAYER ────────────────────────
# URL del Service Layer (incluye /b1s/v1 al final)
SAP_SERVICE_LAYER_URL=https://IP_SERVIDOR_SAP:50000/b1s/v1
# Nombre de la sociedad principal (CompanyDB)
SAP_COMPANY_DB=NOMBRE_SOCIEDAD_SAP

# ─── DOCKER / SAIL ─────────────────────────────────────────
WWWUSER=1000
WWWGROUP=1000

# ─── VITE ──────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
